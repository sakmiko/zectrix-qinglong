# 青龙面板：推荐在「环境变量」创建这些键；本文件也支持复制为 .env。
# 不要把真实密钥、OAuth 登录 JSON 或 .env 上传到公开仓库。
ZECTRIX_DEVICE_ID=AA:BB:CC:DD:EE:FF
ZECTRIX_API_KEY=your_device_cloud_api_key
ZECTRIX_API_BASE=https://cloud.zectrix.com
ZECTRIX_DATA_DIR=/ql/data/config/zectrix
ZECTRIX_DITHER=false
ZECTRIX_MIN_PUSH_SECONDS=60
ZECTRIX_RESERVED_PAGES=3
ZECTRIX_ALLOW_RESERVED_OVERRIDE=false

# 第 3 页：额度/雷达
CODEX_PAGE_ID=3
# 必须使用标准的 CPA Codex JSON；强烈建议单独复制到青龙私有目录。
# 不兼容原 Rust 程序专有的 ZXF1 加密源文件。
CODEX_AUTH_PATH=/ql/data/config/zectrix/codex-auth-copy.json
# 默认将刷新后的 token 以 0600 原子写回上述 JSON（CPA 格式，非 ZXF1）
CODEX_AUTH_WRITE_BACK=true
# 青龙「auth-refresh」任务推荐每 10 分钟运行，但真正调用 API 的最短间隔
CODEX_AUTH_REFRESH_SECONDS=3600
# 额度轮询实际由青龙 cron 控制；暂停时段只略过 quota 任务，独立 radar 不受影响
QUOTA_PAUSE_WINDOWS=00:00-06:00
CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
RADAR_STATUS_URL=https://codex-resets.com/api/v1/status

# 第 1 页：月历（北京时间）
CALENDAR_PAGE_ID=1

# 第 2 页：天气。免 Key 源可用性受网站变化/封锁限制；
# 所有源均失败时只使用未超时的真实缓存，拒绝伪造实时温度
WEATHER_PAGE_ID=2
WEATHER_LOCATION=北京·海淀区
WEATHER_LOCATIONS_FILE=weather_locations.json
WEATHER_PROVIDER=aggregate
WEATHER_AGGREGATE_SOURCES=nmc,weathercn,moji_web,open_meteo,caiyun,qweather,moji
WEATHER_FALLBACK_ORDER=nmc,weathercn,moji_web,open_meteo,caiyun,qweather,moji
WEATHER_HTTP_TIMEOUT_SECS=15
WEATHER_CACHE_MAX_AGE_SECONDS=3600
WEATHER_HOURLY_POINTS=5
WEATHER_HOURLY_STEP_HOURS=4
WEATHER_FORECAST_DAYS=4
OPEN_METEO_API_BASE=https://api.open-meteo.com
# 可选商业气象源
CAIYUN_TOKEN=
QWEATHER_KEY=
QWEATHER_HOST=https://devapi.qweather.com
MOJI_APPCODE=
MOJI_CITY_ID=2
# 可选外观参数
WEATHER_HEADER_BADGE=气象站
WEATHER_TREND_BADGE=24H
WEATHER_TREND_TITLE=趋势
WEATHER_LABEL_FEELS=体感
WEATHER_LABEL_HUMIDITY=湿度
WEATHER_LABEL_AQI=空气
WEATHER_MARGIN_PX=4
WEATHER_CARD_BORDER_PX=2
WEATHER_CARD_SHADOW_PX=2
WEATHER_HERO_TEMP_SHADOW=true
WEATHER_INVERT_MASTHEAD=true
WEATHER_INVERT_TODAY_HEADER=true
